# ============================================
# Секреты и настройки чат-бота «Алина» (Zerocoder)
# Скопируйте этот файл в .env и заполните значения.
# Реальные значения НИКОГДА не записывайте в код и не публикуйте в Git.
# ============================================

# --- Сообщество ВКонтакте ---
# Токен доступа сообщества («Управление сообществом» → «Работа с API» → «Создать ключ доступа»).
# Ключу нужны права: «Сообщения сообщества» и «Управление».
VK_GROUP_TOKEN=ваш_токен_сообщества_vk1a...

# ID сообщества ВКонтакте (необязательно). Если пусто — бот определит ID сам по токену.
VK_GROUP_ID=

# --- GigaChat API ---
# Ключ авторизации (Authorization Key) из личного кабинета Studio:
# проект GigaChat API → раздел «Настройки API» → кнопка «Получить ключ».
# Поля Authorization Key, Client ID и Client Secret показываются только один раз — сохраните их.
GIGACHAT_AUTH_KEY=ваш_ключ_autorization_key...

# Область API (scope): GIGACHAT_API_PERS — физлица;
# GIGACHAT_API_B2B или GIGACHAT_API_CORP — ИП и юрлица.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat: GigaChat-2, GigaChat-2-Pro, GigaChat-2-Max, GigaChat-3-Ultra (freemium для физлиц).
GIGACHAT_MODEL=GigaChat-2-Pro

# Необязательно: путь к вашему файлу сертификата НУЦ Минцифры (.crt/.pem).
# Если не указан — бот сам скачает корневой сертификат в папку certs/.
GIGACHAT_CA_BUNDLE=

# --- Настройки бота Алины ---
# Ссылка на форму заявки отдела продаж (предлагается пользователям в переписке).
SALES_FORM_URL=https://zerocoder.ru/

# Необязательно: сколько последних сообщений из диалога передавать модели (по умолчанию 12).
HISTORY_LIMIT=12
